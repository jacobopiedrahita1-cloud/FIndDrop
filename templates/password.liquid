<h1 class="h2">Volvemos pronto.</h1>
{%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
{%- form 'storefront_password', class: 'page-form' -%}
  {{ form.errors | default_errors }}
  <label class="visually-hidden" for="password">Contraseña</label>
  <input id="password" type="password" name="password" placeholder="Contraseña">
  <button class="btn btn--pink btn--sm" type="submit">Entrar</button>
{%- endform -%}
